# Configuração do gdlint (gdtoolkit) alinhada às convenções do projeto BedLion
max-line-length: 160
tab-characters: 1
max-file-lines: 1000
max-public-methods: 30
function-arguments-number: 10
class-definitions-order:
  - tools
  - classnames
  - extends
  - docstrings
  - signals
  - enums
  - consts
  - staticvars
  - exports
  - pubvars
  - prvvars
  - onreadypubvars
  - onreadyprvvars
  - others
disable:
  - max-returns
